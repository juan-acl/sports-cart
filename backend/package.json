{
  "name": "claro-sports-cart-api",
  "version": "1.0.0",
  "description": "API REST serverless para carrito de compras de artículos deportivos",
  "scripts": {
    "dev": "serverless offline start",
    "build": "tsc",
    "table:create": "tsx scripts/create-table.ts",
    "table:delete": "tsx scripts/delete-table.ts",
    "seed": "tsx scripts/seed-products.ts",
    "bucket:create": "tsx scripts/create-bucket.ts",
    "seeders": "pnpm run table:create && pnpm run bucket:create && pnpm run seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\""
  },
  "keywords": [
    "serverless",
    "lambda",
    "dynamodb",
    "express",
    "ecommerce"
  ],
  "author": "Juan",
  "license": "MIT",
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.1",
    "serverless-offline": "^14.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "awilix": "^13.0.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.6",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
