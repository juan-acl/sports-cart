{
  "name": "claro-sports-cart-api",
  "version": "1.0.0",
  "description": "API REST serverless para carrito de compras de artículos deportivos",
  "scripts": {
    "dev": "serverless offline start",
    "build": "tsc",
    "table:create": "tsx scripts/create-table.ts",
    "table:delete": "tsx scripts/delete-table.ts",
    "seed": "tsx scripts/seed-products.ts",
    "bucket:create": "tsx scripts/create-bucket.ts",
    "seeders": "pnpm run table:create && pnpm run bucket:create && pnpm run seed",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/integration --runInBand",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "format": "biome format --write .",
    "lint": "biome lint --diagnostic-level=error && tsc --noEmit",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "keywords": [
    "serverless",
    "lambda",
    "dynamodb",
    "express",
    "ecommerce"
  ],
  "author": "Juan",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^17.0.7",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.1",
    "serverless-offline": "^14.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "awilix": "^13.0.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.6",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
